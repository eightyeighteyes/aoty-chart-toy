# Copy to .env and fill in. Get a key at https://www.last.fm/api/account/create
LASTFM_API_KEY=

# The server members' Last.fm usernames, comma-separated (spaces around commas are fine)
LASTFM_USERS=alice,bob,carol

# Optional: contact for the MusicBrainz User-Agent (they ask for a real email or URL)
MB_CONTACT=
